[Unit]
Description=BitVoid same-LAN mesh coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bitvoid
Group=bitvoid
ExecStart=/opt/bitvoid/bitvoid_gateway.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bitvoid

[Install]
WantedBy=multi-user.target
